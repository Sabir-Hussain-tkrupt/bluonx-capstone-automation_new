# Controls whether the vendor portal uses the in-memory mock
# (portalApi.mock.ts) or real Axios calls to FastAPI (portalApi.real.ts).
#   true  = mock data, amber "Demo Mode" banner shown
#           (safe for client demos & UI development only)
#   false = real backend calls against FastAPI (default for dev now
#           that Tasks 5.2–5.7 are complete — Phase 5 end-to-end flow)
VITE_DEMO_MODE=false
