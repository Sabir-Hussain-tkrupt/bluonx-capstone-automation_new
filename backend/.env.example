# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# App
APP_ENV=development
DEBUG=true

# CORS (JSON array of allowed origins)
# Production must list real non-localhost https:// origins and must not use "*".
# Startup refuses to boot otherwise (app/core/config.py::_validate_cors_origins).
CORS_ORIGINS=["http://localhost:5173"]

# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: console (human-readable) | json (one object per line, for CloudWatch).
# Leave LOG_FORMAT unset to get json under APP_ENV=production and console elsewhere.
LOG_LEVEL=INFO
# LOG_FORMAT=console

# Google Maps (optional — Haversine-only fallback when absent)
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Email
# Default "mock" sends no real email (safe for local dev). Set to "ses" to send
# real email; "ses" requires the AWS keys below and a verified SES_FROM_EMAIL.
# Production refuses to start unless EMAIL_PROVIDER=ses.
EMAIL_PROVIDER=mock
SES_FROM_EMAIL=noreply@yourdomain.com
# Optional: SES configuration set name to enable delivery/bounce/complaint events
# SES_CONFIGURATION_SET=bluonx-dev

# AWS (required only when EMAIL_PROVIDER=ses)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Vendor portal (Phase 5 — magic link → vendor JWT)
# MUST be different from SUPABASE_JWT_SECRET. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VENDOR_JWT_SECRET=replace-with-long-random-string-min-32-bytes
VENDOR_JWT_EXPIRY_HOURS=4

# Frontend
# Staff/admin app base URL. Invite emails redirect to {FRONTEND_BASE_URL}/accept-invite.
# Production must set a non-localhost https URL (startup refuses otherwise), and the
# same URL must be added to Supabase Auth -> URL Configuration -> Redirect Allow List.
FRONTEND_BASE_URL=http://localhost:5173
